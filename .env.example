# API Keys (optional - basic features work without these)

# US Energy Information Administration (https://www.eia.gov/opendata/)
EIA_API_KEY=

# ENTSO-E Transparency Platform (https://transparency.entsoe.eu/)
ENTSOE_API_KEY=

# OilPriceAPI for EU ETS carbon prices (https://www.oilpriceapi.com/auth/signup)
# Free tier available - provides daily EU carbon allowance prices
OILPRICE_API_KEY=

# EMBER Climate API (https://ember-climate.org/data/api/)
# Free API key - provides carbon intensity data
EMBER_API_KEY=

# Database path (default: data/prices.duckdb)
DATABASE_URL=duckdb:///data/prices.duckdb
